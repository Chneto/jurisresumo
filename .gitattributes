# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Batch and VBS scripts must use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Binary files
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
